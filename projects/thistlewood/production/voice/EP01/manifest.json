    {
      "slate": "CO_06",
      "character": "Richard",
      "voiceId": "kg0h9OdkQiGxVLjqbA9B",
      "model": "eleven_v3",
      "chars": 138,
      "file": "CO_06_Richard.mp3",
      "bytes": 154688,
      "line": "The door doesn't open for cleverness. Never has. And I've very nearly got the clothes sorted. One more tweak and it'll dress you properly."
    },
    {
      "slate": "CO_07",
      "character": "Lily",
      "voiceId": "T5yFNwZamO7NrEhI9ZV6",
      "model": "eleven_v3",
      "chars": 33,
      "file": "CO_07_Lily.mp3",
      "bytes": 33062,
      "line": "You said that last week, Grandad."
