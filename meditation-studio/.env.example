# Copy this file to .env, or paste the keys into the Settings page of the app.
# Keys stay on your computer. They are never shown in the dashboard.

# Claude (writes the scripts). Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# ElevenLabs (voices the scripts). Create a key at https://elevenlabs.io/app/settings/api-keys
# It needs Text to Speech, Voices (read) and User (read) permissions.
ELEVENLABS_API_KEY=

# Optional
PORT=4100
# HOST=127.0.0.1
# FFMPEG_PATH=/usr/local/bin/ffmpeg
