# --- Claude (script generation) ---
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- HeyGen (avatar video generation) ---
# Get from https://app.heygen.com/settings/api
HEYGEN_API_KEY=xxx
# The avatar that plays Monty. Pick one in HeyGen and paste its avatar_id here.
HEYGEN_AVATAR_ID=xxx
# Voice id for Monty (warm, calm, gentle). HeyGen voices endpoint lists these.
HEYGEN_VOICE_ID=xxx
# Vertical 9:16 for TikTok
HEYGEN_WIDTH=720
HEYGEN_HEIGHT=1280
# Optional background image/video asset id
HEYGEN_BACKGROUND_ASSET_ID=

# --- TikTok Content Posting API ---
# Register an app at https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=xxx
TIKTOK_CLIENT_SECRET=xxx
TIKTOK_REDIRECT_URI=http://localhost:3000/oauth/tiktok/callback
# Filled in automatically by `npm run tiktok-auth`. Refresh token used for re-auth.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
# "PUBLIC_TO_EVERYONE" | "MUTUAL_FOLLOW_FRIENDS" | "SELF_ONLY"
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# --- Scheduler ---
# Two TZ-aware cron expressions (defaults: 8am + 7pm local)
POST_CRON_MORNING=0 8 * * *
POST_CRON_EVENING=0 19 * * *
TZ=America/Los_Angeles

# --- Web dashboard ---
PORT=3000
DASHBOARD_TOKEN=changeme
